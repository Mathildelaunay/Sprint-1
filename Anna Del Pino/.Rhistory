w <- 1
} else {
w <- -(1 - exp(-d))
}
} else if (p <= 5) {# Incorrectly predicted in the top five
w <- -(1 - exp(-d))
} else if (p == a) {# Correctly predicted outside the top five
w <- 0.5
} else {# Incorrectly predicted outside the top five
k <- 0.1
w <- -(1 - exp(-k * d))
}
}
wt[i] <- w
}
return(sum(wt))
}
pm_adjusted <- function(predicted, actual, n_features, total_features, lambda = 2) {
original_pm <- pm(predicted, actual)
penalty <- lambda * (n_features / total_features)
adjusted_pm <- original_pm - penalty
return(adjusted_pm)
}
