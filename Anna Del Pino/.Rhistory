if(!dir.exists(file.path("data"))) dir.create(file.path("data"))
if(!file.exists(file.path("data","Database - Odds - England Premier League - unchanged.csv"))) download.file("https://raw.githubusercontent.com/anna-delpino/Group-sprint-0-Sports-Prediction/refs/heads/main/data/Database%20-%20Odds%20-%20England%20Premier%20League%20-%20LS.csv", destfile=file.path("data","Database - Odds - England Premier League - unchanged.csv"))
ds <- read.csv(file.path("data","Database - Odds - England Premier League - unchanged.csv"))
teams <- unique(ds[, 6])
points <- numeric(length(teams))
for (i in 1:length(teams)) {
home_points <- sum(ds[ds[,6] == teams[i], 32], na.rm = TRUE)
away_points <- sum(ds[ds[,7] == teams[i], 33], na.rm = TRUE)
points[i] <- home_points + away_points
}
ranking <- data.frame(Team=teams, Points=points)
ranking <- ranking[order(-ranking$Points), ]
barplot(ranking$Points,
names.arg = ranking$Team,
las = 2,
col = "blue",
main = "2024/25 Points",
xlab = "Team",
ylab = "Points")
goals_scored <- numeric(length(teams))
goals_conceded <- numeric(length(teams))
for (i in 1:length(teams)) {
home_matches <- ds[ds[,6] == teams[i], ]
away_matches <- ds[ds[,7] == teams[i], ]
goals_scored[i] <- sum(home_matches[,8]) + sum(away_matches[,9])
goals_conceded[i] <- sum(home_matches[,9]) + sum(away_matches[,8])
}
plot(goals_scored, goals_conceded,
xlab = "Goals Scored",
ylab = "Goals Conceded",
main = "Goals Scored vs Goals Conceded",
pch = 19)
print(cor(goals_scored, goals_conceded))
