pm_adjusted <- function(predicted, actual, historical_features, season_features, total_historical_features, total_season_features, lambda_H = 1, lambda_S = 2) {
original_pm <- pm(predicted, actual)
penalty_H <- lambda_H *
(historical_features / total_historical_features)
penalty_S <- lambda_S *
(season_features / total_season_features)
adjusted_pm <- original_pm - penalty_H - penalty_S
return(adjusted_pm)
}
