stats <- list(FTGoals= c("FTHG", "FTHG"), HTGoals = c("HTHG", "HTAG"), Shots = c("HS", "AS"), ShotsOnTarget = c("HST", "AST"), Corners = c("HC", "AC"), Fouls = c("HF", "AF"), YellowCards = c("HY", "AY"), RedCards = c("HR", "AR"))
