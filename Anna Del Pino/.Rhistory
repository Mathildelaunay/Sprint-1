############################### Clean the data at 12 noon
prepare_data_at_12noon <- function(D, scale = TRUE) {
scale_num <- function(x) as.numeric(base::scale(x))
D <- D %>%
arrange(date) %>%
rename(
Load = ConsolidatedLoad,
temp = `T_REAL.FR`
) %>%
mutate(
dow   = wday(date, label = TRUE),
toy   = yday(date) / 365,
tod   = hour(date),
year  = year(date),
month = month(date),
yday  = yday(date),
t     = seq(0, 1, length.out = n()),
price_sqrt = sign_sqr(price),
# First 24 lags fixed to the actual value
Load_24  = coalesce(lag(Load,  n = 24), Load),
price_24 = coalesce(lag(price, n = 24), price),
price_sqrt_24 = coalesce(lag(price_sqrt, n = 24), price_sqrt),
# Missing temperature imputed by linear interpolation.
# Assumes no more than one missing temperature in a row.
temp = if_else(
is.na(temp),
(lag(temp) + lead(temp)) / 2,
temp
),
temp95 = exp_smooth(temp, 0.95),
DayValidity = factor(DayValidity),
Ponts       = factor(Ponts),
JourFerie   = factor(JourFerie),
dow         = factor(dow, ordered = FALSE),
is_sat = factor(dow == "Sat"),
is_sun = factor(dow == "Sun"),
is_mon = factor(dow == "Mon"),
mon_lag = if_else(dow == "Mon", price_24, 0),
year_real = paste(year, month, sep = "-")
)
if (scale) {
D <- D %>%
mutate(
across(
c(Load, price, Load_24, price_24, price_sqrt_24, temp, temp95, toy),
scale_num
)
)
}
return(D %>% filter(tod == 12))
}
